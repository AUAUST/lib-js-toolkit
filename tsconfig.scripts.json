{
  "extends": "./tsconfig.json",
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "*.config.ts",
    ".*.ts",
    "tooling/**/*.ts",
    "tooling/**/*.tsx"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.scripts.tsbuildinfo",
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["node"]
  }
}
