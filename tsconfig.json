{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist/types",
    "declarationMap": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@auaust/toolkit/protocols/*": ["./src/protocols/*"],
      "@auaust/toolkit/protocols": ["./src/protocols/index.ts"],
      "@auaust/toolkit/errors": ["./src/errors.ts"],
      "@auaust/toolkit/*": ["./src/functions/*"],
      "@auaust/toolkit": ["./src/index.ts"]
    },
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist"]
}
