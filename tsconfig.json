{
  "extends": "@auaust/engrenage/typescript/presets/base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "dist/types",
    "declarationMap": true,
    "outDir": "dist",
    "paths": {
      "@auaust/toolkit/protocols/*": ["./src/protocols/*/index.ts"],
      "@auaust/toolkit/protocols": ["./src/protocols/index.ts"],
      "@auaust/toolkit/errors": ["./src/errors.ts"],
      "@auaust/toolkit/types": ["./src/types.ts"],
      "@auaust/toolkit/*": [
        "./src/modules/*/index.ts",
        "./src/modules/*.ts",
        "./src/utils/*.ts"
      ],
      "@auaust/toolkit": ["./src/index.ts"]
    },
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist"]
}
