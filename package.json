{
  "name": "@auaust/toolkit",
  "version": "0.5.1",
  "description": "What you need, I provide.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AUAUST/lib-js-toolkit.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Aurian Aubert",
    "email": "aurian@auaust.ch",
    "url": "https://auaust.ch"
  },
  "type": "module",
  "scripts": {
    "build": "engrenage tsdown && engrenage typecheck:dist && engrenage vitest:dist",
    "ci": "pnpm run ci:check && pnpm run ci:test && pnpm run ci:build",
    "ci:build": "pnpm run build",
    "ci:check": "engrenage sync --check && engrenage typecheck && engrenage eslint",
    "ci:publish": "changeset publish",
    "ci:test": "engrenage vitest",
    "coverage": "engrenage vitest:coverage",
    "format": "engrenage prettier",
    "lint": "engrenage eslint",
    "lint:check": "engrenage eslint",
    "lint:fix": "engrenage eslint:fix",
    "lint:suppress": "engrenage eslint:suppress",
    "make": "tsx scripts/make/index.ts",
    "prepare": "engrenage sync",
    "ready": "pnpm install --frozen-lockfile && engrenage sync && pnpm run ci",
    "test": "engrenage vitest && engrenage typecheck",
    "typecheck": "engrenage typecheck",
    "watch": "engrenage vitest:watch --"
  },
  "imports": {
    "#errors/*": "./src/errors/*.ts",
    "#modules/*": "./src/modules/*.ts",
    "#types/*": "./src/types/*.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./array": "./dist/array/index.mjs",
    "./assert": "./dist/assert/index.mjs",
    "./async": "./dist/async/index.mjs",
    "./boolean": "./dist/boolean/index.mjs",
    "./composer": "./dist/composer/index.mjs",
    "./errors": "./dist/errors.mjs",
    "./forwarder": "./dist/forwarder/index.mjs",
    "./function": "./dist/function/index.mjs",
    "./guard": "./dist/guard/index.mjs",
    "./iterable": "./dist/iterable/index.mjs",
    "./maplike": "./dist/maplike/index.mjs",
    "./math": "./dist/math/index.mjs",
    "./number": "./dist/number/index.mjs",
    "./object": "./dist/object/index.mjs",
    "./parse": "./dist/parse/index.mjs",
    "./protocol": "./dist/protocol/index.mjs",
    "./setlike": "./dist/setlike/index.mjs",
    "./string": "./dist/string/index.mjs",
    "./types": "./dist/types.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@auaust/engrenage": "^0.4.3",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "@vitest/coverage-istanbul": "^4.1.11",
    "cleye": "^2.7.0",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.24",
    "tsdown": "0.22.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "sideEffects": false,
  "prettier": "@auaust/engrenage/prettier",
  "packageManager": "pnpm@10.26.0",
  "publishConfig": {
    "access": "public"
  }
}
