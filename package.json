{
  "name": "@auaust/toolkit",
  "license": "GPL-3.0-only",
  "type": "module",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "What you need, I provide.",
  "sideEffects": false,
  "packageManager": "pnpm@10.26.0",
  "author": {
    "name": "Aurian Aubert",
    "email": "aurian@auaust.ch",
    "url": "https://auaust.ch"
  },
  "repository": {
    "url": "git+https://github.com/AUAUST/lib-js-toolkit.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "make": "tsx scripts/make.ts",
    "build": "pnpm run test && pnpm run build:tsdown",
    "build:tsdown": "tsdown --config-loader tsx",
    "coverage": "vitest run --coverage",
    "test": "vitest run --config vitest.config.ts --typecheck -- && pnpm run typecheck",
    "test:dist": "pnpm run build:tsdown && vitest run --config vitest.config.ts --typecheck --mode build --",
    "typecheck": "echo 'Typechecking...' && tsc --noEmit && echo 'All good!'",
    "watch": "vitest --config vitest.config.ts --typecheck --",
    "ci:prepare": "pnpm run typecheck && pnpm run test:dist",
    "ci:publish": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "@vitest/coverage-istanbul": "^4.1.11",
    "cleye": "^2.7.0",
    "publint": "^0.3.24",
    "tsdown": "0.22.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./after": "./dist/after.mjs",
    "./attempt": "./dist/attempt.mjs",
    "./attemptAsync": "./dist/attemptAsync.mjs",
    "./cached": "./dist/cached.mjs",
    "./comparator": "./dist/comparator.mjs",
    "./compare": "./dist/compare.mjs",
    "./constant": "./dist/constant.mjs",
    "./debounce": "./dist/debounce.mjs",
    "./defer": "./dist/defer.mjs",
    "./empty": "./dist/empty.mjs",
    "./errors": "./dist/errors.mjs",
    "./expose": "./dist/expose.mjs",
    "./filled": "./dist/filled.mjs",
    "./forward": "./dist/forward.mjs",
    "./forwardAs": "./dist/forwardAs.mjs",
    "./forwardMethods": "./dist/forwardMethods.mjs",
    "./forwardProperties": "./dist/forwardProperties.mjs",
    "./identity": "./dist/identity.mjs",
    "./isContainer": "./dist/isContainer.mjs",
    "./isPropertyKey": "./dist/isPropertyKey.mjs",
    "./isRegisteredSymbol": "./dist/isRegisteredSymbol.mjs",
    "./isSymbol": "./dist/isSymbol.mjs",
    "./keyMapper": "./dist/keyMapper.mjs",
    "./mapped": "./dist/mapped.mjs",
    "./mappedKeys": "./dist/mappedKeys.mjs",
    "./mappedValues": "./dist/mappedValues.mjs",
    "./match": "./dist/match.mjs",
    "./md5": "./dist/md5.mjs",
    "./measure": "./dist/measure.mjs",
    "./measureAsync": "./dist/measureAsync.mjs",
    "./memoized": "./dist/memoized.mjs",
    "./methodForwarder": "./dist/methodForwarder.mjs",
    "./methodForwarders": "./dist/methodForwarders.mjs",
    "./noop": "./dist/noop.mjs",
    "./now": "./dist/now.mjs",
    "./on": "./dist/on.mjs",
    "./once": "./dist/once.mjs",
    "./pipe": "./dist/pipe.mjs",
    "./pipeAsync": "./dist/pipeAsync.mjs",
    "./propertyForwarder": "./dist/propertyForwarder.mjs",
    "./propertyForwarders": "./dist/propertyForwarders.mjs",
    "./protocols": "./dist/protocols.mjs",
    "./protocols/emptiable": "./dist/protocols/emptiable/index.mjs",
    "./readonly": "./dist/readonly.mjs",
    "./sleep": "./dist/sleep.mjs",
    "./spy": "./dist/spy.mjs",
    "./stopwatch": "./dist/stopwatch.mjs",
    "./tap": "./dist/tap.mjs",
    "./throttle": "./dist/throttle.mjs",
    "./transform": "./dist/transform.mjs",
    "./transformKeys": "./dist/transformKeys.mjs",
    "./transformValues": "./dist/transformValues.mjs",
    "./value": "./dist/value.mjs",
    "./when": "./dist/when.mjs"
  }
}
