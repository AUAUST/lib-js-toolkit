{
  "name": "@auaust/toolkit",
  "version": "0.5.1",
  "description": "What you need, I provide.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AUAUST/lib-js-toolkit.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Aurian Aubert",
    "email": "aurian@auaust.ch",
    "url": "https://auaust.ch"
  },
  "type": "module",
  "scripts": {
    "build": "engrenage tsdown && engrenage typecheck:dist && engrenage vitest:dist",
    "ci": "pnpm run ci:check && pnpm run ci:test && pnpm run ci:build",
    "ci:build": "pnpm run build",
    "ci:check": "engrenage sync --check && engrenage structure --check && engrenage prettier:all --check && pnpm run typecheck && pnpm run lint",
    "ci:publish": "changeset publish",
    "ci:test": "engrenage vitest",
    "coverage": "engrenage vitest:coverage",
    "format": "engrenage prettier",
    "format:all": "engrenage prettier:all",
    "lint": "engrenage eslint",
    "lint:check": "engrenage eslint",
    "lint:fix": "engrenage eslint:fix",
    "lint:suppress": "engrenage eslint:suppress",
    "make": "tsx scripts/make/index.ts",
    "prepare": "lefthook install",
    "ready": "pnpm install --frozen-lockfile && engrenage sync && pnpm run ci && echo 'Ready!'",
    "test": "engrenage vitest && engrenage typecheck",
    "typecheck": "engrenage typecheck",
    "typecheck:dist": "engrenage typecheck:dist",
    "watch": "engrenage vitest:watch"
  },
  "imports": {
    "#errors": "./src/errors/index.ts",
    "#errors/*": "./src/errors/*.ts",
    "#modules/*": "./src/modules/*.ts",
    "#package.json": "./package.json",
    "#scripts/*": "./scripts/*.ts",
    "#tests/*": "./tests/*.ts",
    "#types": "./src/types/index.ts",
    "#types/*": "./src/types/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./array": "./dist/array.mjs",
    "./assert": "./dist/assert.mjs",
    "./async": "./dist/async.mjs",
    "./boolean": "./dist/boolean.mjs",
    "./composer": "./dist/composer.mjs",
    "./errors": "./dist/errors.mjs",
    "./forwarder": "./dist/forwarder.mjs",
    "./function": "./dist/function.mjs",
    "./general": "./dist/general.mjs",
    "./guard": "./dist/guard.mjs",
    "./iterable": "./dist/iterable.mjs",
    "./maplike": "./dist/maplike.mjs",
    "./math": "./dist/math.mjs",
    "./number": "./dist/number.mjs",
    "./object": "./dist/object.mjs",
    "./parse": "./dist/parse.mjs",
    "./protocol": "./dist/protocol.mjs",
    "./setlike": "./dist/setlike.mjs",
    "./string": "./dist/string.mjs",
    "./types": "./dist/types.mjs"
  },
  "files": [
    "dist",
    "data",
    "src"
  ],
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@auaust/engrenage": "^0.11.0",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "baseline-browser-mapping": "^2.11.0",
    "cleye": "^2.7.0",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "jscpd": "^5.0.0",
    "lefthook": "^2.0.0",
    "node-releases": "^2.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "0.23.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-baseline-lib": "^0.1.1",
    "vitest": "^5.0.5"
  },
  "sideEffects": false,
  "prettier": "@auaust/engrenage/prettier",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "restricted"
  }
}
